#!/bin/bash
# Gate: the installed kext must pass kextutil -t -n (static load test, nothing is loaded). A kext that fails it must never stay in
# /Library/Extensions (autoload boot loop, memory feedback_stage_kext_before_autoload), so it is removed and the install fails.
KEXT=/Library/Extensions/OpenAudioBeBoBMAFW.kext
/usr/sbin/chown -R root:wheel "$KEXT" "/Library/Audio/MIDI Drivers/MAudioFireWireMIDI.plugin" /Library/PrivilegedHelperTools/com.openaudio.bebobmafw.helper \
    /Library/LaunchDaemons/com.openaudio.bebobmafw.helper.plist "/Library/Application Support/M-Audio/DeviceIcons"
if ! /usr/bin/kextutil -t -n "$KEXT" >/tmp/openaudio-kextutil.log 2>&1; then
  /bin/rm -rf "$KEXT"
  echo "kextutil -t -n failed; kext removed. See /tmp/openaudio-kextutil.log" >&2
  exit 1
fi
/usr/sbin/kextcache -system-caches >/dev/null 2>&1
/bin/launchctl load -w /Library/LaunchDaemons/com.openaudio.bebobmafw.helper.plist 2>/dev/null
# Launch at login: the agent holds the panel's executable path; point it at this release's panel (0.2.2 renamed it to OA BeBoB MAFW.app).
CU=$(stat -f %Su /dev/console 2>/dev/null)
AGENT="/Users/$CU/Library/LaunchAgents/com.openaudio.bebobmafw.panel.plist"
if [ -n "$CU" ] && [ -f "$AGENT" ]; then
  /usr/libexec/PlistBuddy -c "Set :ProgramArguments:0 /Applications/OA BeBoB MAFW.app/Contents/MacOS/OA BeBoB MAFW" "$AGENT" 2>/dev/null
  /usr/sbin/chown "$CU" "$AGENT" 2>/dev/null
fi
# CoreMIDI reads its driver folder at MIDIServer start; launchd restarts it on demand.
/usr/bin/killall MIDIServer 2>/dev/null
exit 0
