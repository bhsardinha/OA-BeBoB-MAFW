<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>OpenAudio FW1814 @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true" hostArchitectures="x86_64"/>
    <allowed-os-versions><os-version min="10.13"/></allowed-os-versions>
    <choices-outline><line choice="default"><line choice="com.openaudio.fw1814.pkg"/></line></choices-outline>
    <choice id="default"/>
    <choice id="com.openaudio.fw1814.pkg" visible="false"><pkg-ref id="com.openaudio.fw1814.pkg"/></choice>
    <pkg-ref id="com.openaudio.fw1814.pkg" version="@VERSION@" onConclusion="RequireRestart">component.pkg</pkg-ref>
</installer-gui-script>
